---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceSectionNav from "../../components/ResourceSectionNav.astro";
import BookList from "../../components/BookList.astro";

const books = await getCollection("books");
---

<BaseLayout
  title="Libros recomendados"
  description="Una lista curada de libros sobre muerte, duelo y mortalidad."
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href="/recursos/" class="text-sm font-medium text-terracotta hover:text-terracotta-dark">
      ← Todos los recursos
    </a>

    <h1 class="mt-4 font-serif-display text-3xl font-semibold text-ink sm:text-4xl">
      Libros recomendados
    </h1>
    <p class="mt-4 max-w-2xl text-ink-soft">
      Una lista curada sobre muerte, duelo y mortalidad. Se irá ampliando con
      el tiempo.
    </p>

    <div class="mt-8">
      <ResourceSectionNav />
    </div>

    <div class="mt-10">
      <BookList books={books} />
    </div>
  </section>
</BaseLayout>
