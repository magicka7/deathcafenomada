---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceSectionNav from "../../components/ResourceSectionNav.astro";
import PodcastEpisodeList from "../../components/PodcastEpisodeList.astro";

const episodes = await getCollection("podcast");
---

<BaseLayout
  title="Podcast"
  description="Episodios del podcast de Death Cafe Nómada, conversaciones sobre la muerte, el duelo y lo que nos hace estar vivos."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <a href="/recursos/" class="text-sm font-medium text-terracotta hover:text-terracotta-dark">
      ← Todos los recursos
    </a>

    <h1 class="mt-4 font-serif-display text-3xl font-semibold text-ink sm:text-4xl">Podcast</h1>
    <p class="mt-4 max-w-2xl text-ink-soft">
      Conversaciones que extienden lo que pasa en nuestras mesas — sobre la
      muerte, el duelo y lo que nos hace estar vivos.
    </p>

    <div class="mt-8">
      <ResourceSectionNav />
    </div>

    <div class="mt-10">
      <PodcastEpisodeList episodes={episodes} />
    </div>
  </section>
</BaseLayout>
