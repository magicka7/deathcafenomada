---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceSectionNav from "../../components/ResourceSectionNav.astro";
import PodcastEpisodeList from "../../components/PodcastEpisodeList.astro";

const episodes = await getCollection("podcast");

const recommendedChannels = [
  {
    name: "Gaby Pérez Tanatóloga",
    url: "https://www.youtube.com/@GabyPerezTanatologa/videos",
    description: "Gaby Pérez Islas, tanatóloga mexicana, comparte tanatotips, transmisiones en vivo y episodios de su podcast \"Después de la pérdida\" sobre duelo y acompañamiento a personas en fase terminal.",
  },
  {
    name: "Dying in Mexico",
    url: "https://www.youtube.com/@DyingInMexico",
    description: "Podcast y recursos para extranjeros que viven en México sobre cómo planear el final de la vida, la muerte y los trámites de sucesión en un país distinto al de origen.",
  },
  {
    name: "Fundación EKR México Centro",
    url: "https://www.youtube.com/@fundacionekrmexicocentro/videos",
    description: "Canal de la Fundación Elisabeth Kübler-Ross México Centro, con sede en San Miguel de Allende, dedicada a la educación y el acompañamiento en duelo, envejecimiento, enfermedad y muerte.",
  },
];
---

<BaseLayout
  title="Podcast"
  description="Episodios del podcast de Death Cafe Nómada, conversaciones sobre la muerte, el duelo y lo que nos hace estar vivos."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <a href="/recursos/" class="text-sm font-medium text-terracotta hover:text-terracotta-dark">
      ← Todos los recursos
    </a>

    <h1 class="mt-4 font-serif-display text-3xl font-semibold text-ink sm:text-4xl">Podcast</h1>
    <p class="mt-4 max-w-2xl text-ink-soft">
      Conversaciones que extienden lo que pasa en nuestras mesas — sobre la
      muerte, el duelo y lo que nos hace estar vivos.
    </p>

    <div class="mt-8">
      <ResourceSectionNav />
    </div>

    <div class="mt-10">
      <PodcastEpisodeList episodes={episodes} />
    </div>

    <div class="mt-14">
      <h2 class="font-serif-display text-xl font-semibold text-ink">
        Canales recomendados en YouTube
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-ink-soft">
        Mientras preparamos nuestro propio podcast, aquí algunos canales de
        habla hispana sobre duelo, tanatología y el final de la vida.
      </p>

      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          recommendedChannels.map((channel) => (
            <a
              href={channel.url}
              class="block rounded-2xl border border-sand bg-paper p-5 transition-shadow hover:shadow-md"
              rel="noopener"
              target="_blank"
            >
              <h3 class="font-serif-display text-base font-semibold text-ink">
                {channel.name}
              </h3>
              <p class="mt-2 text-sm text-ink-soft">{channel.description}</p>
              <span class="mt-3 inline-block text-sm font-semibold text-terracotta hover:text-terracotta-dark">
                Ver canal →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
