---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResourceSectionNav from "../../../components/ResourceSectionNav.astro";
import ArticleCard from "../../../components/ArticleCard.astro";

const allArticles = await getCollection("legadoDigital", ({ data }) => !data.draft);
const articles = allArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Legado digital"
  description="Qué pasa con nuestras fotografías, cuentas, mensajes y activos digitales cuando morimos, y qué cambia con la inteligencia artificial."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <a href="/recursos/" class="text-sm font-medium text-terracotta hover:text-terracotta-dark">
      ← Todos los recursos
    </a>

    <h1 class="mt-4 font-serif-display text-3xl font-semibold text-ink sm:text-4xl">Legado digital</h1>
    <p class="mt-4 max-w-2xl text-ink-soft">
      La vida que dejamos en internet: fotografías, correos, mensajes privados,
      cuentas, criptomonedas y, cada vez más, réplicas hechas con inteligencia
      artificial. Reflexiones sobre lo que queda de nosotros en la red.
    </p>

    <div class="mt-8">
      <ResourceSectionNav />
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        articles.length > 0 ? (
          articles.map((article) => <ArticleCard article={article} basePath="/recursos/legado-digital/" />)
        ) : (
          <p class="text-ink-soft">Todavía no hay artículos publicados.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
