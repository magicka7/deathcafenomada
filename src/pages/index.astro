---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PageEdgeDivider from "../components/PageEdgeDivider.astro";
import ConceptExplainer from "../components/ConceptExplainer.astro";
import CTAButton from "../components/CTAButton.astro";
---

<BaseLayout
  title="Death Cafe Nómada"
  description="Encuentros abiertos y gratuitos para hablar de la muerte, con té o café, sin agenda terapéutica ni religiosa. Empezamos en Cholula, Puebla."
>
  {/* Aviso de temporada — quitar pasado septiembre, no hay sistema de vigencia por fecha */}
  <div class="border-b border-sand bg-paper px-4 py-2.5 text-center text-sm sm:px-6">
    <span class="font-mono text-base font-bold tracking-[0.04em] text-honey">septiembre — mes del testamento</span>
    <span class="text-ink-soft"> · </span>
    <a
      href="/recursos/testamento/testamento-mexico/#costos-por-estado"
      class="font-medium text-terracotta underline underline-offset-2 hover:text-terracotta-dark"
    >
      hasta 50% de descuento en notarías, revisa los costos por estado →
    </a>
  </div>

  <Hero />
  <PageEdgeDivider />
  <ConceptExplainer />

  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
    <h2 class="font-serif-display text-2xl font-semibold text-ink sm:text-3xl">
      ¿Quieres saber de dónde viene todo esto?
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-ink-soft">
      Death Cafe nació en Europa hace más de una década y hoy se vive en
      decenas de países. Conoce su historia y cómo llegó a México.
    </p>
    <div class="mt-6">
      <CTAButton href="/origen/">Ver la historia del movimiento</CTAButton>
    </div>
  </section>
</BaseLayout>
