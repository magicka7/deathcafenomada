---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/EventCard.astro";

export async function getStaticPaths() {
  const cities = await getCollection("cities");
  return cities.map((city) => ({
    params: { slug: city.id },
    props: { city },
  }));
}

const { city } = Astro.props;
const { name, state, status, shortDescription, howToArrive, mapEmbedUrl } = city.data;

const allEvents = await getCollection("events");
const upcomingEvents = allEvents
  .filter((e) => e.data.citySlug === city.id && e.data.date.getTime() >= Date.now())
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<BaseLayout title={name} description={shortDescription}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href="/ciudades/" class="text-sm font-medium text-terracotta hover:text-terracotta-dark">
      ← Todas las ciudades
    </a>

    <div class="mt-4 flex items-center gap-3">
      <h1 class="font-serif-display text-3xl font-semibold text-ink sm:text-4xl">{name}</h1>
      <span
        class:list={[
          "rounded-full px-3 py-1 text-xs font-semibold",
          status === "activa" ? "bg-olive/15 text-olive" : "bg-sand text-ink-soft",
        ]}
      >
        {status === "activa" ? "Activa" : "Próximamente"}
      </span>
    </div>
    <p class="text-ink-soft">{state}</p>

    <p class="mt-6 max-w-2xl text-ink-soft">{shortDescription}</p>

    <div class="mt-10 space-y-4">
      <h2 class="font-serif-display text-xl font-semibold text-ink">Próximos encuentros</h2>
      {
        upcomingEvents.length > 0 ? (
          upcomingEvents.map((event) => <EventCard event={event} cityName={name} />)
        ) : (
          <p class="text-ink-soft">Aún no hay una fecha confirmada para esta ciudad.</p>
        )
      }
    </div>

    <div class="mt-10">
      <h2 class="font-serif-display text-xl font-semibold text-ink">Cómo llegar</h2>
      <p class="mt-3 text-ink-soft">{howToArrive}</p>
      {mapEmbedUrl && (
        <div class="mt-5 overflow-hidden rounded-2xl border border-sand">
          <iframe
            src={mapEmbedUrl}
            class="h-72 w-full"
            loading="lazy"
            title={`Mapa de ${name}`}
          />
        </div>
      )}
    </div>
  </section>
</BaseLayout>
