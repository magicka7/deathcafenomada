---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const cities = await getCollection("cities");
  return cities.map((city) => ({
    params: { slug: city.id },
    props: { city },
  }));
}

const { city } = Astro.props;
const { name, state, status, shortDescription } = city.data;

const allEvents = await getCollection("events");
const cityEvents = allEvents
  .filter((e) => e.data.citySlug === city.id)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const startOfToday = new Date();
startOfToday.setUTCHours(0, 0, 0, 0);

const numbered = cityEvents.map((event, i) => ({
  event,
  n: i + 1,
  isPast: event.data.date.getTime() < startOfToday.getTime(),
}));
const upcoming = numbered.filter((e) => !e.isPast);
const past = numbered.filter((e) => e.isPast).reverse();
const ordered = [...upcoming, ...past];

const formatDate = (date: Date) => {
  const raw = date.toLocaleDateString("es-MX", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
  return raw.charAt(0).toUpperCase() + raw.slice(1);
};
---

<BaseLayout title={name} description={shortDescription}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href="/ciudades/" class="text-sm font-medium text-olive hover:text-olive-dark">
      ← Todas las ciudades
    </a>

    <div class="mt-4 flex items-center gap-3">
      <h1 class="font-serif-display text-3xl font-semibold text-ink sm:text-4xl">{name}</h1>
      <span
        class:list={[
          "rounded-full px-3 py-1 text-xs font-semibold",
          status === "activa" ? "bg-olive/15 text-olive" : "bg-sand text-ink-soft",
        ]}
      >
        {status === "activa" ? "Activa" : "Próximamente"}
      </span>
    </div>
    <p class="text-ink-soft">{state}</p>

    <p class="mt-6 max-w-2xl text-ink-soft">{shortDescription}</p>

    <div class="mt-10 space-y-4">
      <h2 class="font-serif-display text-xl font-semibold text-ink">
        {upcoming.length > 0 ? "Próximos encuentros" : "Encuentros"}
      </h2>
      {
        ordered.length > 0 ? (
          ordered.map(({ event, n, isPast }, i) => {
            const isNext = !isPast && i === 0;
            return (
              <>
                {isPast && i === upcoming.length && (
                  <h2 class="font-serif-display pt-6 text-xl font-semibold text-ink">
                    Encuentros realizados
                  </h2>
                )}
              <div id={event.id} class="scroll-mt-24 rounded-2xl border border-sand bg-paper p-6 sm:p-8">
                <p class="text-xs font-semibold uppercase tracking-wider text-honey">
                  archivo n.º {n} {isPast ? "· realizado" : isNext ? "· siguiente encuentro" : "· próximo encuentro"}
                </p>
                <p class="mt-2 font-serif-display text-xl font-semibold text-ink sm:text-2xl">
                  {formatDate(event.data.date)} · {event.data.time}
                </p>
                <p class="mt-3 text-sm text-ink-soft">{event.data.venueName}</p>
                <p class="text-sm text-ink-soft">{event.data.venueAddress}</p>
                {event.data.mapUrl && (
                  <a
                    href={event.data.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-block border border-terracotta px-3 py-1.5 text-sm font-medium text-terracotta transition-colors hover:bg-terracotta hover:text-cream"
                  >
                    Ver en Google Maps ↗
                  </a>
                )}
                {isPast && event.data.recap && (
                  <p class="mt-3 text-sm text-ink-soft italic">{event.data.recap}</p>
                )}
                {!isPast && event.data.notes && (
                  <p class="mt-3 text-sm text-ink-soft italic">{event.data.notes}</p>
                )}
              </div>
              </>
            );
          })
        ) : (
          <p class="text-ink-soft">Aún no hay una fecha confirmada para esta ciudad.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
