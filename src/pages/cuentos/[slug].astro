---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const cuentos = await getCollection("cuentos");
  return cuentos.map((cuento) => ({
    params: { slug: cuento.id },
    props: { cuento },
  }));
}

const { cuento } = Astro.props;
const { title, author, date, excerpt } = cuento.data;
const { Content } = await render(cuento);
---

<ArticleLayout title={title} description={excerpt} author={author} date={date}>
  <Content />
</ArticleLayout>
