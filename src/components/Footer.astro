---
const year = new Date().getFullYear();
---

<footer class="border-t border-sand bg-cream">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <a
      href="https://www.instagram.com/deathcafe.nomada/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm text-ink-soft transition-colors hover:text-terracotta"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
      </svg>
      @deathcafe.nomada
    </a>

    <p class="mt-8 text-xs text-ink-soft/80">
      © {year} Death Cafe <span class="text-terracotta">Nómada</span>. Inspirado en el movimiento internacional{" "}
      <a href="https://deathcafe.com" class="underline hover:text-terracotta" rel="noopener">Death Cafe</a>.
    </p>
  </div>
</footer>
