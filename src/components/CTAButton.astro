---
interface Props {
  href: string;
  variant?: "solid" | "outline";
  class?: string;
}

const { href, variant = "solid", class: className = "" } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-colors";
const styles =
  variant === "solid"
    ? "border border-terracotta text-terracotta hover:bg-terracotta hover:text-cream"
    : "border border-terracotta text-terracotta-dark hover:bg-terracotta hover:text-cream";
---

<a href={href} class:list={[base, styles, className]}>
  <slot />
</a>
