---
import type { CollectionEntry } from "astro:content";

interface Props {
  links: CollectionEntry<"links">[];
}

const { links } = Astro.props;

const categoryLabels: Record<CollectionEntry<"links">["data"]["category"], string> = {
  duelo: "Duelo",
  tanatologia: "Tanatología",
  "cuidados-paliativos": "Cuidados paliativos",
  "linea-de-apoyo": "Líneas de apoyo",
};

const categories = Object.keys(categoryLabels) as Array<
  keyof typeof categoryLabels
>;
---

<div class="space-y-10">
  {
    categories.map((category) => {
      const items = links.filter((l) => l.data.category === category);
      if (items.length === 0) return null;
      return (
        <div>
          <h3 class="font-serif-display text-lg font-semibold text-olive">
            {categoryLabels[category]}
          </h3>
          <ul class="mt-3 space-y-3">
            {items.map((item) => (
              <li class="rounded-xl border border-sand bg-paper p-4">
                <a
                  href={item.data.url}
                  class="font-semibold text-terracotta-dark hover:underline"
                  rel="noopener"
                >
                  {item.data.title}
                </a>
                {item.data.description && (
                  <p class="mt-1 text-sm text-ink-soft">{item.data.description}</p>
                )}
              </li>
            ))}
          </ul>
        </div>
      );
    })
  }
</div>
