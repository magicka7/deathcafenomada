---
import type { CollectionEntry } from "astro:content";

interface Props {
  cuento: CollectionEntry<"cuentos">;
}

const { cuento } = Astro.props;
const { title, author, date, excerpt, youtubeUrl } = cuento.data;

const formattedDate = date.toLocaleDateString("es-MX", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<a
  href={`/recursos/cuentos/${cuento.id}/`}
  class="group block rounded-2xl border border-sand bg-paper p-6 transition-shadow hover:shadow-md"
>
  {youtubeUrl && (
    <span class="inline-flex items-center gap-1.5 rounded-full border border-terracotta/30 bg-terracotta/10 px-3 py-1 text-xs font-semibold text-terracotta-dark">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
      Video
    </span>
  )}
  <p class:list={["text-xs text-ink-soft", youtubeUrl && "mt-2"]}>
    {author && <span>{author} · </span>}
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </p>
  <h3 class="mt-2 font-serif-display text-xl font-semibold text-ink">{title}</h3>
  <p class="mt-3 text-sm text-ink-soft">{excerpt}</p>
  <span class="mt-4 inline-block text-sm font-semibold text-terracotta group-hover:text-terracotta-dark">
    Leer más →
  </span>
</a>
