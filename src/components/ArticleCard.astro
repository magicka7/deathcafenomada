---
import type { CollectionEntry } from "astro:content";

interface Props {
  article:
    | CollectionEntry<"articles">
    | CollectionEntry<"legadoDigital">
    | CollectionEntry<"ejemplos">
    | CollectionEntry<"entierroEcologico">
    | CollectionEntry<"duelo">;
  basePath?: string;
  linkLabel?: string;
}

const { article, basePath = "/recursos/testamento/", linkLabel = "Leer más →" } = Astro.props;
const { title, date, excerpt } = article.data;

const formattedDate = date.toLocaleDateString("es-MX", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<a
  href={`${basePath}${article.id}/`}
  class="group block rounded-2xl border border-sand bg-paper p-6 transition-shadow hover:shadow-md"
>
  <p class="text-xs text-ink-soft">
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </p>
  <h3 class="mt-2 font-serif-display text-xl font-semibold text-ink">{title}</h3>
  <p class="mt-3 text-sm text-ink-soft">{excerpt}</p>
  <span class="mt-4 inline-block text-sm font-semibold text-terracotta group-hover:text-terracotta-dark">
    {linkLabel}
  </span>
</a>
