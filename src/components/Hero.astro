---
import CTAButton from "./CTAButton.astro";
---

<section class="border-b border-sand bg-paper">
  <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
    <p class="font-serif-display text-sm uppercase tracking-[0.2em] text-terracotta-dark">
      Un espacio para conversar
    </p>
    <h1 class="mt-4 font-serif-display text-4xl font-semibold leading-tight text-ink sm:text-5xl">
      Death Cafe Nómada
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-ink-soft">
      Un Death Cafe es una charla abierta y gratuita sobre la muerte, con té y
      pastel, sin agenda terapéutica ni religiosa — solo un grupo de personas
      escuchándose.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <CTAButton href="#proximo-encuentro">Ver el próximo encuentro</CTAButton>
      <CTAButton href="/ciudades/" variant="outline">Conoce las ciudades</CTAButton>
    </div>
  </div>
</section>
