---
const items = [
  { href: "/recursos/voluntad-anticipada/", label: "Voluntad anticipada" },
  { href: "/recursos/testamento/", label: "Testamento" },
  { href: "/recursos/legado-digital/", label: "Legado digital" },
  { href: "/recursos/ejemplos/", label: "Ejemplos" },
  { href: "/recursos/entierro-ecologico/", label: "Entierro ecológico" },
  { href: "/recursos/kubler-ross/", label: "Kübler-Ross" },
  { href: "/recursos/libros/", label: "Libros recomendados" },
  { href: "/recursos/enlaces/", label: "Enlaces útiles" },
  { href: "/recursos/cuentos/", label: "Cuentos" },
  { href: "/recursos/podcast/", label: "Podcast" },
];

const currentPath = Astro.url.pathname;
---

<nav class="flex flex-wrap gap-2" aria-label="Subsecciones de Recursos">
  {
    items.map((item) => {
      const isActive = currentPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          class:list={[
            "rounded-full border px-4 py-2 text-sm font-medium transition-colors",
            isActive
              ? "border-terracotta bg-terracotta text-cream"
              : "border-sand text-ink-soft hover:border-terracotta hover:text-terracotta-dark",
          ]}
        >
          {item.label}
        </a>
      );
    })
  }
</nav>
