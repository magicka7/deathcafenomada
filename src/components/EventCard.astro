---
import type { CollectionEntry } from "astro:content";

interface Props {
  event: CollectionEntry<"events">;
  cityName: string;
}

const { event, cityName } = Astro.props;
const { date, time, venueName, venueAddress, notes } = event.data;

const rawFormattedDate = date.toLocaleDateString("es-MX", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const formattedDate =
  rawFormattedDate.charAt(0).toUpperCase() + rawFormattedDate.slice(1);
---

<div class="rounded-2xl border border-sand bg-paper p-6 sm:p-8">
  <p class="text-xs font-semibold uppercase tracking-wider text-honey">
    Próximo encuentro
  </p>
  <p class="mt-2 font-serif-display text-xl font-semibold text-ink sm:text-2xl">
    {formattedDate} · {time}
  </p>
  <p class="mt-1 text-terracotta-dark font-medium">{cityName}</p>
  <p class="mt-3 text-sm text-ink-soft">{venueName}</p>
  <p class="text-sm text-ink-soft">{venueAddress}</p>
  {notes && <p class="mt-3 text-sm text-ink-soft italic">{notes}</p>}
</div>
