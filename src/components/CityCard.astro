---
import type { CollectionEntry } from "astro:content";

interface Props {
  city: CollectionEntry<"cities">;
  nextEventDate?: Date;
}

const { city, nextEventDate } = Astro.props;
const { name, state, status, shortDescription, isPrimary } = city.data;

const formattedDate = nextEventDate
  ? nextEventDate.toLocaleDateString("es-MX", { month: "short", day: "numeric", timeZone: "UTC" })
  : null;
---

<a
  href={`/ciudades/${city.id}/`}
  class="group block rounded-2xl border border-sand bg-paper p-6 transition-shadow hover:shadow-md"
>
  <div class="flex items-center justify-between gap-2">
    <h3 class="font-serif-display text-xl font-semibold text-ink">{name}</h3>
    {isPrimary && (
      <span class="rounded-full bg-honey/30 px-3 py-1 text-xs font-semibold text-terracotta-dark">
        Ciudad ancla
      </span>
    )}
  </div>
  <p class="text-sm text-ink-soft">{state}</p>

  <p class="mt-3 text-sm text-ink-soft">{shortDescription}</p>

  <div class="mt-4 flex items-center justify-between text-sm">
    <span
      class:list={[
        "rounded-full px-3 py-1 text-xs font-semibold",
        status === "activa"
          ? "bg-olive/15 text-olive"
          : "bg-sand text-ink-soft",
      ]}
    >
      {status === "activa" ? "Activa" : "Próximamente"}
    </span>
    {formattedDate && (
      <span class="text-ink-soft">Próximo: {formattedDate}</span>
    )}
  </div>

  <span class="mt-4 inline-block text-sm font-semibold text-terracotta group-hover:text-terracotta-dark">
    Ver detalles →
  </span>
</a>
