---
import { getCollection } from "astro:content";
import EventCard from "./EventCard.astro";

const events = await getCollection("events");
const cities = await getCollection("cities");

const featured =
  events.find((e) => e.data.isFeatured) ??
  events
    .filter((e) => e.data.date.getTime() >= Date.now())
    .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())[0];

const city = featured
  ? cities.find((c) => c.id === featured.data.citySlug)
  : undefined;
---

<section id="proximo-encuentro" class="mx-auto max-w-3xl px-4 py-4 sm:px-6">
  {
    featured && city ? (
      <EventCard event={featured} cityName={city.data.name} />
    ) : (
      <div class="rounded-2xl border border-sand bg-paper p-6 text-center text-ink-soft">
        Aún no hay un próximo encuentro anunciado. Vuelve pronto.
      </div>
    )
  }
</section>
