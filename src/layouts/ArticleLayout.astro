---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  author?: string;
  date: Date;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  author,
  date,
  backHref = "/recursos/cuentos/",
  backLabel = "← Volver a Cuentos",
} = Astro.props;

const formattedDate = date.toLocaleDateString("es-MX", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
    <a href={backHref} class="text-sm font-medium text-terracotta hover:text-terracotta-dark">
      {backLabel}
    </a>

    <h1 class="mt-6 font-serif-display text-3xl font-semibold text-ink sm:text-4xl">
      {title}
    </h1>

    <p class="mt-3 text-sm text-ink-soft">
      {author && <span>{author} · </span>}
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </p>

    <div class="prose-cuento mt-10 text-ink">
      <slot />
    </div>
  </article>
</BaseLayout>
